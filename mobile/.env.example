# URLs publicas, sem segredos. O prefixo /api/v1 e adicionado pelos clientes.
#
# Computador / Expo Web:
# EXPO_PUBLIC_DOTNET_API_URL=http://localhost:8081
# EXPO_PUBLIC_JAVA_API_URL=http://localhost:8080
#
# Android Emulator: localhost aponta para o emulador; use 10.0.2.2 para acessar o host.
# EXPO_PUBLIC_DOTNET_API_URL=http://10.0.2.2:8081
# EXPO_PUBLIC_JAVA_API_URL=http://10.0.2.2:8080
#
# Dispositivo fisico com Expo Go: use o IP LAN da maquina, alcancavel na mesma rede.
# Exemplo: http://192.168.1.50:8081 e http://192.168.1.50:8080.
# O APK avaliado deve usar URLs HTTPS estaveis e publicamente alcancaveis.
EXPO_PUBLIC_DOTNET_API_URL=http://localhost:8081
EXPO_PUBLIC_JAVA_API_URL=http://localhost:8080

# Injetar no build publicado. A tela Sobre exibe exatamente este valor.
EXPO_PUBLIC_GIT_COMMIT_HASH=development
