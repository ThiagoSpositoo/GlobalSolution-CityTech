# Referencia das variaveis consumidas pelo backend Java.
# A configuracao local canonica fica em ../.env e e carregada por ./run-local.sh.
ORACLE_JDBC_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_USERNAME=CITYTECH
ORACLE_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=citytech_local
RABBITMQ_PASSWORD=

JWT_ISSUER=citytech-identity
JWT_AUDIENCE=citytech-api
JWT_KEY_ID=citytech-local-v1
JWT_PUBLIC_KEY_PATH=./secrets/jwt/public.pem

JAVA_SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://127.0.0.1:19006,http://localhost:8081,http://127.0.0.1:8081
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_DELAY_MS=2000
AI_CHAT_MODEL=configured-chat-model
