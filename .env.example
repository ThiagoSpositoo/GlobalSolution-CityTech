# MODELO: nenhum valor secreto real. Não usar como configuração de produção.
# Docker Compose lê .env. Os backends precisam receber as variáveis no processo.
# Execute os comandos a partir desta raiz para resolver os caminhos relativos.
COMPOSE_PROJECT_NAME=citytech

# Digests resolvidos na Etapa 3A; manter equivalentes aos defaults do Compose.
RABBITMQ_IMAGE=rabbitmq@sha256:753099a19b577c322117f793f864b3129cbba96d40317221a69d73976e3c843c
ORACLE_IMAGE=gvenzl/oracle-xe@sha256:f82bccdf6020d27373fdf0e93046b63eb3f777a0289e329d9839feebaf4555de
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server@sha256:4525e3efac9f3e241cb003bb2ff2a82818b502f37e12049d788b1a9fa7e13b7f
MONGODB_IMAGE=mongo@sha256:bdc216e9d5a6ec2cfdac789b5832fdab64cd32055f59885cae918a92de63c361

RABBITMQ_USER=citytech_local
RABBITMQ_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_DELAY_MS=2000
JAVA_SERVER_PORT=8080

# Preencher Y somente após ler/aceitar os termos do SQL Server.
MSSQL_ACCEPT_EULA=
MSSQL_SA_PASSWORD=
SQLSERVER_PORT=1433
# SA é para bootstrap local. API futura usará usuário próprio restrito.
DOTNET_DB_CONNECTION=

MONGODB_ROOT_USER=citytech_local_admin
MONGODB_ROOT_PASSWORD=
MONGODB_PORT=27017
MONGODB_DATABASE=citytech_demo

# Oracle local: XE 21, service XEPDB1. No ambiente FIAP, substitua URL/usuario.
# Senha administrativa e senha da aplicacao devem ser distintas.
ORACLE_ADMIN_PASSWORD=
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_JDBC_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_USERNAME=CITYTECH
ORACLE_PASSWORD=

# Contrato de autenticação (Etapa 3B): .NET assina RS256; Java valida a chave pública.
# Gere as chaves conforme o README. O diretório secrets/ e os PEMs são ignorados pelo Git.
JWT_ISSUER=citytech-identity
JWT_AUDIENCE=citytech-api
JWT_PRIVATE_KEY_PATH=./secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt/public.pem
JWT_KEY_ID=citytech-local-v1
JWT_EXPIRES_MINUTES=60

# Seed local opcional e controlado. Definir os três juntos; não versionar a senha.
MANAGER_SEED_NAME=
MANAGER_SEED_EMAIL=
MANAGER_SEED_PASSWORD=

# Limites iniciais configuráveis da API .NET.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_FOLLOWUPS_PER_MINUTE=60

# Chamada interna do .NET ao Java para validar occurrenceId (contratos-api.md).
# Em dev, o Java expõe /api/v1 em http://localhost:8080.
JAVA_API_BASE_URL=http://localhost:8080
DOTNET_API_BASE_URL=http://localhost:8081

# CORS local dos dois backends. Acrescente a origem do Expo Web/IP LAN quando necessário.
# Esta variável não habilita CORS de produção: .NET limita a Development e Java ao profile local.
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://127.0.0.1:19006,http://localhost:8081,http://127.0.0.1:8081

# Provedor/modelos serão escolhidos e testados na etapa IA autorizada.
AI_API_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=configured-chat-model
AI_EMBEDDING_MODEL=

# Valores públicos. localhost é apenas referência para o computador.
# Celular/emulador exigem hostname/IP alcançável; APK final exige HTTPS estável.
EXPO_PUBLIC_JAVA_API_URL=http://localhost:8080
EXPO_PUBLIC_DOTNET_API_URL=http://localhost:8081
